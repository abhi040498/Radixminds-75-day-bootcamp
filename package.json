{
  "name": "radix-minds-board-bootcamp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/src/start.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "build:hostinger": "npm run build && npm run build:api",
    "build:netlify": "npm run build && npm run build:api && npm run audit:secrets",
    "test": "npm run test:policies && npm run test:enrolment && npm run test:webhook && npm run test:payment && npm run test:api-test-launcher && npm run test:whatsapp && npm run test:refunds && npm run test:config",
    "test:netlify-function": "esbuild netlify/functions/api.ts --bundle --platform=node --format=cjs --packages=external --outfile=server/dist/netlify-function-local.cjs && node scripts/test-netlify-function.mjs",
    "audit": "npm run audit:secrets",
    "audit:secrets": "node scripts/audit-secret-values.mjs",
    "test:webhook": "tsx --test server/test/razorpayWebhook.test.ts",
    "test:api-test-launcher": "node --test scripts/test-api-env.test.mjs",
    "test:whatsapp": "tsx --test server/test/whatsappConfirmation.test.ts",
    "test:refunds": "tsx --test server/test/refunds.test.ts",
    "test:config": "node --test server/test/config.test.mjs server/test/netlifyProxy.test.mjs && tsx --test server/test/originPolicy.test.ts",
    "test:enrolment": "tsx --test server/test/enrolmentProgramSelection.test.ts server/test/enrolmentConfirmation.test.ts server/test/enrolmentSession.test.ts server/test/enrolmentRecovery.test.ts server/test/paymentCheckoutRecovery.test.ts server/test/subjectSnapshot.test.ts",
    "test:payment": "tsx --test server/test/paymentIntegrity.test.ts server/test/paymentOrderConcurrency.test.ts server/test/paymentClaimError.test.ts server/test/razorpayDiagnostics.test.ts",
    "test:policies": "tsx --test server/test/policyAcknowledgement.test.ts",
    "start": "node server/dist/start.js",
    "start:api": "node server/dist/start.js",
    "start:api:test": "node scripts/start-api-test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@netlify/functions": "^6.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
