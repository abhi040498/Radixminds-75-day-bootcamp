# Copy to .env.test.local and fill only with configuration and credentials from the isolated test project.
# Do not copy production values into this file.
# Set both URL values to the isolated TEST project's exact HTTPS URL in .env.test.local.
# This committed example intentionally uses placeholders; configure the actual URL in Netlify Deploy Preview settings.
SUPABASE_URL=REPLACE_WITH_ISOLATED_TEST_PROJECT_URL
RADIXMINDS_TEST_SUPABASE_URL=REPLACE_WITH_ISOLATED_TEST_PROJECT_URL
SUPABASE_PUBLIC_KEY=REPLACE_WITH_TEST_PROJECT_PUBLIC_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_TEST_PROJECT_SECRET_KEY
STATUS_TOKEN_SECRET=REPLACE_WITH_RANDOM_TEST_ONLY_SECRET_AT_LEAST_32_CHARS
PORT=4001
APP_ORIGIN=http://localhost:5173
PAYMENT_ENABLED=false
POLICIES_APPROVED=false
RAZORPAY_MODE=test
