NODE_ENV=production
PORT=4000
APP_ORIGIN=https://bootcamp.radixminds.in

# Supabase server credentials. Never use VITE_ prefixes for secret values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLIC_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Payment integration is intentionally not activated in this phase.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ENABLED=false

# Keep false until the final terms and privacy notice are approved.
POLICIES_APPROVED=false
STATUS_TOKEN_SECRET=replace-with-at-least-32-random-characters

BOARD_OPTIONS=CBSE,ICSE,State Board,Other
LANGUAGE_OPTIONS=English,Hindi,Bilingual
WHATSAPP_PHONE=919304829718
TELEGRAM_URL=https://t.me/radixminds
